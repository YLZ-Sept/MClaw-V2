{
  "modules": [
    {
      "id": "vector-memory",
      "name": "向量记忆增强",
      "description": "让 Akita 拥有长期记忆，能根据语义搜索历史对话。体积较大（约 2.5GB，含 PyTorch），安装耗时较长",
      "packages": [
        "sentence-transformers>=2.2.0,<3.0",
        "chromadb>=0.4.0",
        "regex>=2023.6.3,<2025"
      ],
      "estimated_size_mb": 2500,
      "category": "core",
      "model": {
        "kind": "sentence-transformers",
        "name": "BAAI/bge-small-zh-v1.5"
      }
    },
    {
      "id": "vector-lite",
      "name": "轻量语义检索",
      "description": "本地 ONNX 向量检索（约 60MB，含 int8 模型），无需 PyTorch；知识库语义召回用",
      "packages": [
        "onnxruntime>=1.18",
        "tokenizers>=0.15",
        "numpy>=1.26"
      ],
      "estimated_size_mb": 80,
      "category": "core",
      "model": {
        "kind": "onnx",
        "name": "bge-small-zh-v1.5",
        "file": "model_quantized.onnx"
      }
    },
    {
      "id": "whisper",
      "name": "离线语音识别",
      "description": "使用 OpenAI Whisper 进行离线语音转文字（约 2.5GB，含 PyTorch）",
      "packages": [
        "openai-whisper>=20231117",
        "static-ffmpeg>=2.7"
      ],
      "estimated_size_mb": 2500,
      "category": "media"
    },
    {
      "id": "orchestration",
      "name": "多智能体协作",
      "description": "通过 ZeroMQ 支持多智能体协作（约 10MB）",
      "packages": [
        "pyzmq>=25.0.0"
      ],
      "estimated_size_mb": 10,
      "category": "agents"
    }
  ]
}
